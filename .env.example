# ==============================================================================
# SISTEM MANAJEMEN PENGAJIAN & PEMBINAAN GENERASI QUR'ANI
# Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Database, Auth, and Connection Pooler)
# ------------------------------------------------------------------------------
# Region: Singapore (sin1)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Supabase Supavisor Connection Pooler (Port 6543) - For Serverless Vercel
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. WhatsApp Gateway (WAHA via Petapod.com REST API)
# ------------------------------------------------------------------------------
PETAPOD_WAHA_URL="https://waha-instance.petapod.com"
PETAPOD_WAHA_API_KEY=""
PETAPOD_WAHA_SESSION="default"
PETAPOD_WAHA_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 3. Cloudinary (Khusus Foto Lembar Kerja, Foto Profil & Banner - Auto WebP/AVIF)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_URL="cloudinary://your-cloudinary-api-key:your-cloudinary-api-secret@your-cloudinary-cloud-name"

# ------------------------------------------------------------------------------
# 4. Cloudflare R2 (Khusus File Audio Hafalan - 10 GB Gratis & Zero Egress Fee)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="sistem-pengajian-audio"
R2_PUBLIC_DOMAIN="https://pub-your-bucket-hash.r2.dev"

# ------------------------------------------------------------------------------
# 5. Upstash Redis (Edge Rate Limiting & Memory Caching)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token"

# ------------------------------------------------------------------------------
# 6. WhatsApp Sandbox & Testing Protection (Anti-Ganggu Data Real)
# ------------------------------------------------------------------------------
WA_MOCK_MODE="true"                     # Jika true pesan di-render dicatat ke DB/console tanpa menembak gateway WA
WA_TEST_OVERRIDE_PHONE=""    # Jika diisi, SELURUH pesan WA dialihkan ke nomor tester ini saja
CRON_SECRET="admin"   # Secret token otorisasi cron scheduler
CRON_ADMIN_REPORT_PHONE=""    # Nomor WA Admin penerima rekap sukses/gagal cron

# ------------------------------------------------------------------------------
# 7. Application General Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Sistem Pengajian"
MAGIC_LINK_SECRET="admin"
